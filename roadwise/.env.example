# RoadWise Environment Configuration
# Copy this file to .env and adjust values for your environment

# ============================================================
# BACKEND SETTINGS
# ============================================================

# Secret key for JWT signing — CHANGE THIS in production!
SECRET_KEY=changeme-roadwise-secret-key-minimum-32-chars-long

# JWT algorithm
ALGORITHM=HS256

# Token expiry in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database URL
# Development (SQLite):
DATABASE_URL=sqlite:///./roadwise.db
# Production (PostgreSQL with PostGIS):
# DATABASE_URL=postgresql+psycopg2://roadwise:password@localhost:5432/roadwise

# Path to compiled C++ engine executable
ENGINE_PATH=../engine/build/roadwise_engine.exe
# Linux/Mac:
# ENGINE_PATH=../engine/build/roadwise_engine

# Environment: development | staging | production
ENVIRONMENT=development

# File upload directory
UPLOAD_DIR=./uploads

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# FRONTEND SETTINGS (prefix with VITE_)
# ============================================================

VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=RoadWise
VITE_ENVIRONMENT=development

# ============================================================
# DATABASE SETTINGS (for Docker Compose)
# ============================================================

POSTGRES_DB=roadwise
POSTGRES_USER=roadwise
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
